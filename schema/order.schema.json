{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SafeLegalAI/us-court-ai-orders/schema/order.schema.json",
  "title": "US court AI order / rule",
  "description": "One row per official court instrument (standing order, administrative/general order, local rule, practice direction, policy or notice) that addresses the use of artificial intelligence in proceedings before a United States court. Coding is done from the primary text by SafeLegalAI; the court's words are quoted, never paraphrased into obligations the text does not contain.",
  "type": "object",
  "required": ["order_id", "title", "document_type", "court_level", "court", "state", "applies_to", "obligations", "summary", "source_url", "source_type", "fetched_at", "verification", "lead_source"],
  "properties": {
    "order_id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "slug: <court_code>-<judge-last-name|court>-<yyyy>-<short-title>" },
    "title": { "type": "string" },
    "document_type": { "enum": ["standing-order", "administrative-order", "general-order", "local-rule", "practice-direction", "policy", "notice", "judge-requirements-page", "proposed-rule"] },
    "court_level": { "enum": ["federal-appellate", "federal-district", "federal-bankruptcy", "federal-magistrate", "federal-specialty", "state-supreme", "state-appellate", "state-trial", "state-judiciary-wide", "territorial", "tribal"] },
    "court": { "type": "string" },
    "court_code": { "type": ["string", "null"] },
    "state": { "type": ["string", "null"] },
    "judge": { "type": ["string", "null"] },
    "judge_role": { "enum": ["district-judge", "magistrate-judge", "bankruptcy-judge", "chief-judge", "circuit-judge", "justice", "trial-judge", "appellate-judge", null] },
    "issued_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "effective_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "amended_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$" },
    "status": { "enum": ["in-force", "superseded", "rescinded", "proposed", "unknown"] },
    "ai_scope": { "enum": ["generative-ai", "any-ai", "named-tools", "unclear"] },
    "applies_to": { "type": "array", "items": { "enum": ["attorneys", "pro-se-litigants", "all-filers", "parties", "court-staff", "judges", "jurors", "witnesses"] }, "minItems": 1 },
    "case_types": { "type": "array", "items": { "enum": ["civil", "criminal", "bankruptcy", "appellate", "family", "all"] } },
    "obligations": {
      "type": "object",
      "required": ["ai_drafting", "disclose_use", "disclose_tool", "disclose_how_used", "certify_accuracy", "certify_human_review", "certify_confidentiality", "verify_citations", "mark_ai_sections", "retain_prompts", "ai_generated_evidence_disclosure", "ai_recording_in_courtroom", "warning_only"],
      "properties": {
        "ai_drafting": { "enum": ["permitted", "permitted-with-conditions", "prohibited", "not-addressed"] },
        "disclose_use": { "enum": ["required", "required-on-request", "not-required", "not-addressed"] },
        "disclose_tool": { "enum": ["required", "not-required", "not-addressed"] },
        "disclose_how_used": { "enum": ["required", "not-required", "not-addressed"] },
        "certify_accuracy": { "enum": ["required-each-filing", "required-once", "not-required", "not-addressed"] },
        "certify_human_review": { "enum": ["required", "not-required", "not-addressed"] },
        "certify_confidentiality": { "enum": ["required", "not-required", "not-addressed"] },
        "verify_citations": { "enum": ["required", "not-addressed"] },
        "mark_ai_sections": { "enum": ["required", "not-required", "not-addressed"] },
        "retain_prompts": { "enum": ["required", "not-required", "not-addressed"] },
        "ai_generated_evidence_disclosure": { "enum": ["required", "not-required", "not-addressed"] },
        "ai_recording_in_courtroom": { "enum": ["prohibited", "permitted", "not-addressed"] },
        "warning_only": { "type": "boolean" }
      }
    },
    "sanctions_language": { "type": ["string", "null"], "maxLength": 300 },
    "key_provisions": { "type": "array", "items": { "type": "string", "maxLength": 240 }, "minItems": 1, "maxItems": 7 },
    "summary": { "type": "string", "minLength": 150, "maxLength": 520 },
    "source_url": { "type": "string", "format": "uri" },
    "source_type": { "enum": ["court-website", "uscourts-judge-page", "govinfo", "courtlistener-recap", "state-court-site", "state-judiciary-site", "court-pdf"] },
    "secondary_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "archive_url": { "type": ["string", "null"] },
    "fetched_at": { "type": "string", "format": "date" },
    "text_sha256": { "type": ["string", "null"] },
    "text_excerpt": { "type": ["string", "null"], "maxLength": 600 },
    "verification": { "enum": ["fetched-and-read", "fetched-not-parsed", "page-read-no-document", "link-only"] },
    "lead_source": { "type": "array", "items": { "enum": ["court-site-crawl", "uscourts-search", "edrm", "rails", "legalrealist", "ropes-gray-citation", "safelegalai-regulation-tracker", "news-report", "other"] } },
    "notes": { "type": ["string", "null"] }
  }
}
